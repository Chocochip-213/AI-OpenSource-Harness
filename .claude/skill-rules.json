{
  "skills": [
    {
      "name": "recipe-authoring",
      "description": "Recipe creation, modification, and SSOT docs management",
      "keywords": [
        "recipe", "template", "plan.md", "context.md", "tasks.md",
        "recipe.yaml", "requirements", "install.sh", "run.sh", "SSOT",
        "scaffold", "boilerplate",
        "레시피", "템플릿", "아키텍처", "구조", "설계", "문서",
        "의사결정", "계획", "범위", "접근법"
      ],
      "intentPatterns": [
        "(?i)(add|create|new|modify|update|edit|start)\\s.*(recipe|레시피)",
        "(?i)(copy|cp).*_template",
        "(?i)(plan|context|tasks)\\s*(doc|md|문서|업데이트|수정)",
        "(?i)recipe\\.yaml",
        "(?i)(architecture|structure|design)\\s+(for|of)",
        "(?i)(새|시작|추가|수정|업데이트).*레시피",
        "(?i)(결정|판단).*(기록|저장|남기)"
      ],
      "pathPatterns": [
        "recipes/*/docs/plan.md",
        "recipes/*/docs/context.md",
        "recipes/*/docs/tasks.md",
        "recipes/*/recipe.yaml"
      ],
      "priority": 10,
      "enforcement": "suggest",
      "hint": "Read the SSOT triad (plan/context/tasks.md) before making changes. Update tasks.md after each step."
    },
    {
      "name": "colab-debugging",
      "description": "Colab runtime issues: install failures, package conflicts, CUDA/GPU, OOM",
      "keywords": [
        "colab", "install", "pip", "cuda", "gpu", "oom", "runtime",
        "conflict", "dependency", "error", "fail", "crash",
        "ImportError", "ModuleNotFoundError", "RuntimeError",
        "torch", "torchvision", "diffusers", "transformers", "accelerate",
        "xformers", "triton", "safetensors", "nvidia-smi", "cu12", "cudnn",
        "condacolab", "conda", "mamba",
        "spconv", "nvdiffrast", "cumesh", "flash-attn", "flash_attn",
        "wheel", "binary", "compilation", "build error", "build fail",
        "kernel restart", "timeout", "SIGKILL", "segfault",
        "C extension", "native extension", ".so",
        "CUDA mismatch", "compute capability", "sm_80", "sm_120",
        "VRAM", "out of memory", "torch.cuda",
        "dtype", "ABI", "version mismatch",
        "ATTN_BACKEND", "SPARSE_CONV_BACKEND",
        "코랩", "런타임", "의존성",
        "패키지", "충돌", "설치", "메모리", "오류", "에러",
        "컴파일", "빌드", "환경", "버전", "호환", "재시작",
        "안돌아", "안됨", "실패",
        "illegal memory access", "Killed", "pip-freeze",
        "rollback", "롤백", "이전 런타임"
      ],
      "intentPatterns": [
        "(?i)(fix|debug|solve|resolve)\\s.*(install|import|package|dependency|colab|error)",
        "(?i)(pip|conda|mamba)\\s*(install|conflict|error)",
        "(?i)(cuda|gpu|oom|out[\\s._]of[\\s._]memory)",
        "(?i)(ModuleNotFoundError|ImportError|RuntimeError|AttributeError|ValueError)",
        "(?i)(build|compile|wheel)\\s*(fail|error)",
        "(?i)(version|ABI|dtype)\\s*(mismatch|conflict|error)",
        "(?i)(설치|빌드|컴파일).*(실패|에러|오류)",
        "(?i)(호환|버전).*(문제|충돌|오류)",
        "(?i)(코랩|colab).*(안돼|안됨|에러|오류|문제|실패)",
        "(?i)(런타임|runtime).*(변경|롤백|버전|문제)"
      ],
      "pathPatterns": ["recipes/**/requirements*.txt", "recipes/**/install.sh"],
      "priority": 20,
      "enforcement": "suggest",
      "hint": "Check colab-runtimes/runtimes.json for pre-installed versions. Use compat-debugger agent for complex conflicts.",
      "injectFiles": ["colab-runtimes/quick-reference.md"]
    },
    {
      "name": "notebook-builder",
      "description": "Colab notebook generation from manifest, cell definitions, install/run cells",
      "keywords": [
        "notebook", "ipynb", "generate", "manifest",
        "writefile", "cell", "generate_notebook",
        "notebook_manifest", "colab notebook",
        "노트북", "셀", "생성", "매니페스트"
      ],
      "intentPatterns": [
        "(?i)(generate|create|build|make)\\s.*(notebook|ipynb|노트북)",
        "(?i)notebook_manifest",
        "(?i)%%writefile",
        "(?i)generate_notebook",
        "(?i)(노트북|셀).*(생성|만들|수정)"
      ],
      "pathPatterns": ["recipes/**/notebook_manifest.yaml", "outputs/notebooks/**"],
      "priority": 15,
      "enforcement": "suggest",
      "hint": "Ensure notebook_manifest.yaml is up-to-date before generating. Run: uv run python tools/generate_notebook.py <recipe>"
    },
    {
      "name": "session-end",
      "description": "Session wrap-up: update docs, memory, commit, push, generate handoff prompt",
      "keywords": [
        "session-end", "handoff", "wrap up",
        "세션종료", "마무리", "핸드오프", "다른세션", "다른컴퓨터",
        "세션마무리", "인수인계", "이어가기", "넘기기"
      ],
      "intentPatterns": [
        "(?i)(session|세션)\\s*(end|종료|마무리|close)",
        "(?i)(wrap|finish|conclude)\\s*(up|session)",
        "(?i)(다른|새)\\s*(세션|컴퓨터|머신)",
        "(?i)handoff|핸드오프|인수인계",
        "(?i)(오늘|이번).*(마무리|끝|종료)"
      ],
      "pathPatterns": [],
      "priority": 5,
      "enforcement": "suggest",
      "hint": "Run /session-end to save all context, commit, push, and generate a handoff prompt."
    },
    {
      "name": "pre-compact",
      "description": "Pre-compact preparation: persist critical context before auto-compact triggers",
      "keywords": [
        "pre-compact", "compact", "context save",
        "컴팩트", "맥락정리", "컨텍스트",
        "context full", "context limit", "token limit",
        "맥락 부족", "압축", "축약"
      ],
      "intentPatterns": [
        "(?i)(pre[\\s-]?compact|before.*compact)",
        "(?i)(context|맥락|컨텍스트).*(full|limit|가득|부족|정리|저장|save)",
        "(?i)compact.*전에",
        "(?i)(save|persist|preserve).*context"
      ],
      "pathPatterns": [],
      "priority": 3,
      "enforcement": "suggest",
      "hint": "Run /pre-compact to persist critical context to files and get a recommended /compact summary."
    },
    {
      "name": "fresh-start",
      "description": "Save context to SSOT docs, then /clear for a clean slate (better than repeated /compact)",
      "keywords": [
        "fresh-start", "clear", "fresh start", "clean slate",
        "새로 시작", "깨끗하게", "클리어", "초기화",
        "context poisoning", "맥락 오염"
      ],
      "intentPatterns": [
        "(?i)(fresh[\\s-]?start|clean\\s*slate)",
        "(?i)(clear|클리어).*(시작|resume|이어|재개)",
        "(?i)(context|맥락).*(오염|poison|꼬|이상)",
        "(?i)(새로|처음부터|깨끗).*(시작|재개)"
      ],
      "pathPatterns": [],
      "priority": 2,
      "enforcement": "suggest",
      "hint": "Run /fresh-start to save context to SSOT docs, then /clear for a clean restart. Better than repeated /compact."
    }
  ]
}
