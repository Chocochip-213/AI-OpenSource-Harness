{
  "skills": [
    {
      "name": "recipe-authoring",
      "description": "Recipe creation, modification, and SSOT docs management",
      "keywords": [
        "recipe", "레시피", "template", "plan.md", "context.md", "tasks.md",
        "recipe.yaml", "requirements", "install.sh", "run.sh", "SSOT"
      ],
      "intentPatterns": [
        "(?i)(add|create|new|modify|update|edit)\\s.*(recipe|레시피)",
        "(?i)(copy|cp).*_template",
        "(?i)(plan|context|tasks)\\s*(doc|md|문서)",
        "(?i)recipe\\.yaml"
      ],
      "pathPatterns": ["recipes/*/docs/*", "recipes/*/recipe.yaml"],
      "priority": 10,
      "enforcement": "suggest",
      "hint": "Read the SSOT triad (plan/context/tasks.md) before making changes. Update tasks.md after each step."
    },
    {
      "name": "colab-debugging",
      "description": "Colab runtime issues: install failures, package conflicts, CUDA/GPU, OOM",
      "keywords": [
        "colab", "install", "pip", "cuda", "gpu", "oom", "runtime",
        "conflict", "dependency", "error", "fail", "crash", "패키지", "충돌",
        "설치", "메모리", "ImportError", "ModuleNotFoundError"
      ],
      "intentPatterns": [
        "(?i)(fix|debug|solve|resolve)\\s.*(install|import|package|dependency|colab|error)",
        "(?i)(pip|conda)\\s*(install|conflict|error)",
        "(?i)(cuda|gpu|oom|out.of.memory)",
        "(?i)(ModuleNotFoundError|ImportError|RuntimeError)"
      ],
      "pathPatterns": ["recipes/*/requirements*.txt", "recipes/*/install.sh"],
      "priority": 20,
      "enforcement": "suggest",
      "hint": "Check requirements files for version pins. Use compat-debugger agent for complex conflicts."
    },
    {
      "name": "notebook-builder",
      "description": "Colab notebook generation from manifest, %%writefile cells, install/run cells",
      "keywords": [
        "notebook", "노트북", "ipynb", "colab", "generate", "manifest",
        "writefile", "cell", "셀", "generate_notebook"
      ],
      "intentPatterns": [
        "(?i)(generate|create|build|make)\\s.*(notebook|ipynb|노트북)",
        "(?i)notebook_manifest",
        "(?i)%%writefile",
        "(?i)generate_notebook"
      ],
      "pathPatterns": ["recipes/*/notebook_manifest.yaml", "outputs/notebooks/*"],
      "priority": 15,
      "enforcement": "suggest",
      "hint": "Ensure notebook_manifest.yaml is up-to-date before generating. Run: uv run python tools/generate_notebook.py <recipe>"
    }
  ]
}
