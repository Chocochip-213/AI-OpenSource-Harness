# Python / IDE / OS
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Claude Code personal + machine-local state.
# `.claude/_*` wildcard catches EVERY underscore-prefixed state file —
# current (logs, markers, session IDs, audit snapshots) and future
# ones new hooks might introduce. Prevents silent leaks if an author
# forgets to add a specific rule.
.claude/_*
.claude/CLAUDE.md
.claude/.env
.claude/last_recipe.txt
.claude/settings.local.json
.claude/handoffs/

# Secrets — defense in depth (session-end skill also regex-scans staged files).
.env
.env.local
.env.production
.env.development
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*

# Local overrides + generated artifact dirs
.mcp.json.local
outputs/
